# MongoDB Atlas SRV connection string (Database Access user + Network Access IP).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/Podcasts?retryWrites=true&w=majority

MONGODB_DB=Podcasts
MONGODB_COLLECTION=transcripts

VECTOR_INDEX=transcript_vector_index
SEARCH_INDEX=transcript_search_index
EMBEDDING_MODEL=voyage-4

# Flask
SECRET_KEY=change-me
FLASK_DEBUG=0
